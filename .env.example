# Replace both placeholders. Never distribute the upstream key to clients.
PROMPTSIEVE_PROXY_TOKEN=replace-with-a-long-random-proxy-token
PROMPTSIEVE_OPENAI_API_KEY=replace-with-your-openai-api-key
PROMPTSIEVE_MODE=enforce
PROMPTSIEVE_UPSTREAM_ORIGIN=https://api.openai.com
PROMPTSIEVE_MAX_REQUEST_BYTES=1048576
PROMPTSIEVE_MAX_CONCURRENCY=32
PROMPTSIEVE_BODY_TIMEOUT=15
PROMPTSIEVE_CONNECT_TIMEOUT=10
PROMPTSIEVE_READ_TIMEOUT=60
PROMPTSIEVE_TOTAL_TIMEOUT=300
